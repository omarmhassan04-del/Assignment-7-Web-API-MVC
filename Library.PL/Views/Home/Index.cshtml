@{
    ViewData["Title"] = "Home Page";
}

<div class="p-5 mb-4 bg-light rounded-3 shadow-sm">
    <div class="container-fluid py-5">
        <h1 class="display-5 fw-bold">📖 Library Management System</h1>
        <p class="col-md-8 fs-4">Welcome to the Library Management MVC Application. Manage authors, books, and loans using modern ASP.NET Core MVC with Entity Framework Core and N-Tier Architecture.</p>
        <div class="mt-4">
            <a class="btn btn-primary btn-lg me-2" asp-controller="Books" asp-action="Index">Manage Books</a>
            <a class="btn btn-outline-secondary btn-lg" asp-controller="Authors" asp-action="Index">Manage Authors</a>
        </div>
    </div>
</div>

<div class="row align-items-md-stretch">
    <div class="col-md-6 mb-3">
        <div class="h-100 p-4 text-white bg-dark rounded-3">
            <h2>📚 Books Collection</h2>
            <p>Browse the full list of books, view details, register new titles, and track availability.</p>
            <a class="btn btn-outline-light" asp-controller="Books" asp-action="Index">Go to Books</a>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="h-100 p-4 bg-light border rounded-3">
            <h2>✍️ Authors Registry</h2>
            <p>Organize literary authors, check their biographies, and see books linked to each author.</p>
            <a class="btn btn-outline-dark" asp-controller="Authors" asp-action="Index">Go to Authors</a>
        </div>
    </div>
</div>
