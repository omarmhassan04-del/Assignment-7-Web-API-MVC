@model Library.DAL.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<h1>Book Details</h1>
<hr />

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-info text-white">
        <h4 class="mb-0">@Model.Title</h4>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Author</dt>
            <dd class="col-sm-9">@(Model.Author != null ? Model.Author.Name : "N/A")</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ISBN)</dt>
            <dd class="col-sm-9"><code>@Model.ISBN</code></dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Price)</dt>
            <dd class="col-sm-9">@Model.Price.ToString("C")</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Genre)</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Genre) ? "Unspecified" : Model.Genre)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PublicationYear)</dt>
            <dd class="col-sm-9">@Model.PublicationYear</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsAvailable)
                {
                    <span class="badge bg-success">Available for Loan</span>
                }
                else
                {
                    <span class="badge bg-danger">Currently Borrowed</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
