@model Library.DAL.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<h1 class="text-danger">Delete Book</h1>
<h3>Are you sure you want to delete this book?</h3>
<hr />

<div class="card mb-4 border-danger shadow-sm">
    <div class="card-header bg-danger text-white">
        <h4 class="mb-0">@Model.Title</h4>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Author</dt>
            <dd class="col-sm-9">@(Model.Author != null ? Model.Author.Name : "N/A")</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ISBN)</dt>
            <dd class="col-sm-9"><code>@Model.ISBN</code></dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Price)</dt>
            <dd class="col-sm-9">@Model.Price.ToString("C")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Confirm Delete" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
