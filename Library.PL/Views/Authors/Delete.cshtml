@model Library.DAL.Models.Author

@{
    ViewData["Title"] = "Delete Author";
}

<h1 class="text-danger">Delete Author</h1>
<h3>Are you sure you want to delete this author?</h3>
<hr />

<div class="card mb-4 border-danger shadow-sm">
    <div class="card-header bg-danger text-white">
        <h4 class="mb-0">@Model.Name</h4>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.BirthDate)</dt>
            <dd class="col-sm-9">@Model.BirthDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Biography)</dt>
            <dd class="col-sm-9">@Model.Biography</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Confirm Delete" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
